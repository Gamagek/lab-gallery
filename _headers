# compressor-headers:start
# Compressor assets are static: no Functions, D1 or upload processing.
/compress/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval' https://reviews.lowestitem.com; worker-src 'self' blob:; connect-src 'self' blob: https://reviews.lowestitem.com https://cdn.jsdelivr.net; img-src 'self' blob: data: https://reviews.lowestitem.com; media-src 'self' blob:; style-src 'self' https://reviews.lowestitem.com; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'

/compress/assets/*
  Cache-Control: public, max-age=31536000, immutable

/compress/
  Cache-Control: public, max-age=0, must-revalidate
  Link: <https://www.lowestitem.com/compress/>; rel="canonical"
# compressor-headers:end
